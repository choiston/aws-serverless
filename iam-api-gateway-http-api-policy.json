{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageHttpApiForLambda",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowApiGatewayInvokePermission",
      "Effect": "Allow",
      "Action": "lambda:AddPermission",
      "Resource": "arn:aws:lambda:ap-northeast-2:086015456585:function:myTest"
    }
  ]
}
